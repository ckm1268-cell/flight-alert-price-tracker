# GitHub Actions secrets (never commit real values, never put in frontend)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # server-side only
TRAVELPAYOUTS_TOKEN=
RESEND_API_KEY=
RESEND_FROM=Flight Alerts <alerts@your-verified-domain.com>
MAX_FARE_AGE_HOURS=48
# GitHub repository VARIABLES (public, used to build frontend/config.js at deploy)
#   SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY
# Local dev flags: DRY_RUN=1 (no writes/emails), MOCK=1 (no network, SIMULATED data)
